{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rodar extensão (Loxia)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: compile",
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
